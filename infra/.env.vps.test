# AudioMind VPS environment simulation for CI / local `docker compose config` and
# scripts/deploy-vps.sh preflight testing ONLY. All values below are fake but
# well-formed enough to satisfy the `${VAR:?...}` compose requirements and the
# scripts/deploy-vps.sh validate_required_vars() / validate_database_tls_mode()
# checks. Do not use on a real VPS and never store real secrets in this file.

APP_ENV=production
DEPLOYMENT_MODE=vps
DATABASE_TLS_MODE=disable
DATABASE_TLS_PRIVATE_HOSTS=db,postgres

PUBLIC_DOMAIN=example.test
PUBLIC_ORIGIN=https://example.test
PUBLIC_FRONTEND_ORIGIN=https://example.test
CORS_ALLOWED_ORIGINS=https://example.test
RUN_PUBLIC_SMOKE=0

POSTGRES_DB=audiomind
POSTGRES_USER=audiomind
POSTGRES_PASSWORD=VpsTestPass_At@Colon:Slash/Hash#Pct%Ok

# Host is "db" (private Docker service name) — password URL-encoded from the
# POSTGRES_PASSWORD above via scripts/generate-vps-db-url.py.
AI_DATABASE_URL=postgresql://audiomind:VpsTestPass_At%40Colon%3ASlash%2FHash%23Pct%25Ok@db:5432/audiomind

REDIS_HOST=redis
REDIS_PORT=6379
USER_REDIS_DB=3

AUDIO_STORAGE_PATH=/app/uploads
FINAL_AUDIO_ALLOWED_ROOTS=/app/uploads

JWT_SECRET=vps-test-jwt-secret-fake-minimum-32-characters-xx
JWT_ACCESS_EXPIRATION_SECONDS=86400
INTERNAL_SERVICE_TOKEN=vps-test-fake-internal-token-16
GOOGLE_INTERNAL_SERVICE_TOKEN=vps-test-fake-internal-token-16

GOOGLE_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
GOOGLE_TOKEN_ENCRYPTION_KID=v1

WEB_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=8080
WEB_HOST_PORT=8080
USER_API_BIND_ADDRESS=127.0.0.1
USER_HOST_PORT=8083
USER_API_HOST_PORT=8083
MEETING_API_BIND_ADDRESS=127.0.0.1
MEETING_HOST_PORT=8081
MEETING_API_HOST_PORT=8081
PROCESSING_API_BIND_ADDRESS=127.0.0.1
PROCESSING_HOST_PORT=8082
PROCESSING_API_HOST_PORT=8082
AI_HOST_PORT=8000
AI_API_HOST_PORT=8000

VITE_USER_API_BASE_URL=__SAME_ORIGIN__
VITE_MEETING_API_BASE_URL=__SAME_ORIGIN__
VITE_PROCESSING_API_BASE_URL=__SAME_ORIGIN__
VITE_API_BASE=__SAME_ORIGIN__
VITE_API_CPU_BASE=__SAME_ORIGIN__
VITE_API_GPU_BASE=__SAME_ORIGIN__
VITE_AI_SERVICE_URL=
VITE_REALTIME_WS_ENABLED=true
VITE_REALTIME_WS_BASE_URL=wss://example.test/ws/meetings
VITE_GOOGLE_LOGIN_ENABLED=true
VITE_PAYOS_ENABLED=false
VITE_REALTIME_ENABLED=true

STT_PROVIDER=deepgram
ANALYSIS_PROVIDER=gemini
AI_PROVIDER=gemini

DEEPGRAM_API_KEY=dg-test-fake-key-not-real-xxxxxx
GEMINI_API_KEY=gemini-test-fake-key-not-real-xxxx

ENABLE_SPEAKER_DIARIZATION=false
DEEPGRAM_DIARIZE=false

LOCAL_WHISPER_ENABLED=false
ALLOW_LEGACY_LOCAL_STT=false
OLLAMA_ENABLED=false
ALLOW_LEGACY_LOCAL_AI=false

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
JOB_STATE_REDIS_URL=redis://redis:6379/2
CELERY_CONCURRENCY=2
CELERY_PREFETCH_MULTIPLIER=1

NOTIFICATION_FRONTEND_BASE_URL=https://example.test
NOTIFICATION_BRAND_NAME=AudioMind
NOTIFICATION_BRAND_ACCENT_COLOR=#5b4bff
NOTIFICATION_FROM_EMAIL=noreply@example.test
MEETING_SHARE_NOTIFICATIONS_ENABLED=true
GMAIL_SEND_ENABLED=false

GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://example.test/auth/google/callback
GOOGLE_OAUTH_LINK_REDIRECT_URI=https://example.test/auth/google/link/callback
GOOGLE_OAUTH_FRONTEND_BASE_URL=https://example.test
GOOGLE_OAUTH_ALLOWED_REDIRECT_ORIGINS=https://example.test
PAYOS_ENABLED=false
