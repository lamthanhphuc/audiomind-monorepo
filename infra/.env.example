# AudioMind â€” local full-feature template (Epic 3 + optional PayOS / Google / SMTP).
# 1) Copy to infra/.env   2) Search "REPLACE_" and fill your keys   3) Set *_ENABLED=true where noted
# Do not commit infra/.env.

# =============================================================================
# Deployment identity
# =============================================================================
APP_ENV=development
DOMAIN_ROOT=localhost
PUBLIC_FRONTEND_ORIGIN=http://localhost:8080
PUBLIC_API_ORIGIN=http://localhost:8082
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=8080
MEETING_API_BIND_ADDRESS=127.0.0.1
MEETING_API_HOST_PORT=8081
PROCESSING_API_BIND_ADDRESS=127.0.0.1
PROCESSING_API_HOST_PORT=8082
USER_API_BIND_ADDRESS=127.0.0.1
USER_API_HOST_PORT=8083

# =============================================================================
# Database â€” FILL: strong password for non-local deploy
# =============================================================================
POSTGRES_DB=audiomind
POSTGRES_USER=audiomind
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/audiomind
SPRING_DATASOURCE_USERNAME=audiomind
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=3
REALTIME_REDIS_STREAMS_ENABLED=false
GEMINI_SHARED_COOLDOWN_ENABLED=false

# =============================================================================
# Auth â€” FILL: JWT_SECRET (min 32 random chars)
# =============================================================================
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRATION_SECONDS=86400

# =============================================================================
# PayOS â€” FILL keys, then set PAYOS_ENABLED=true and VITE_PAYOS_ENABLED=true, rebuild web
# Quota UX + PayOS checklist:
# 1. PAYOS_ENABLED=true (user-service)
# 2. VITE_PAYOS_ENABLED=true (rebuild FE-Audiomind web image)
# 3. PAYOS_RETURN_URL / PAYOS_CANCEL_URL trá» Ä‘Ăºng host FE (8080 hoáº·c 5173)
# 4. Sau thanh toĂ¡n: /billing/success?orderCode=... â†’ poll activation
# =============================================================================
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=REPLACE_WITH_PAYOS_CLIENT_ID
PAYOS_API_KEY=REPLACE_WITH_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=REPLACE_WITH_PAYOS_CHECKSUM_KEY
PAYOS_RETURN_URL=http://localhost:8080/billing/success
PAYOS_CANCEL_URL=http://localhost:8080/billing/cancel
BILLING_PRO_PRICE_VND=79000

# =============================================================================
# Google Login + Calendar â€” FILL client id/secret, set GOOGLE_OAUTH_ENABLED=true
# Console redirect: http://localhost:8083/auth/google/callback
# =============================================================================
GOOGLE_OAUTH_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8083/auth/google/callback
GOOGLE_OAUTH_LINK_REDIRECT_URI=http://localhost:8083/auth/google/link/callback
GOOGLE_OAUTH_FRONTEND_BASE_URL=http://localhost:8080
GOOGLE_OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
GOOGLE_OAUTH_STATE_TTL=10m
GOOGLE_LOGIN_TICKET_TTL=90s
GOOGLE_LOGIN_TICKET_MARKER_TTL=10m
# FILL: openssl rand -base64 32  (or keep generated dev key below)
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
GOOGLE_TOKEN_ENCRYPTION_KID=v1
GOOGLE_INTERNAL_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_INTERNAL_SERVICE_TOKEN
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_INTERNAL_SERVICE_TOKEN

# Phase 2: AI worker fetches subject membership before Gemini (optional locally).
MEETING_SERVICE_BASE_URL=http://meeting-api:8081
MEETING_SERVICE_TIMEOUT_SECONDS=10

# =============================================================================
# SMTP â€” FILL (optional): SMTP_HOST, SMTP_USER, SMTP_PASSWORD, NOTIFICATION_FROM_EMAIL
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@audiomind.local
# Share-invite email links (register / open meeting). Falls back to PUBLIC_FRONTEND_ORIGIN in application.yml.
NOTIFICATION_FRONTEND_BASE_URL=http://localhost:8080
# HTML email branding (Gmail share invites)
NOTIFICATION_BRAND_NAME=AudioMind
NOTIFICATION_BRAND_ACCENT_COLOR=#5b4bff
GMAIL_SEND_ENABLED=true
MEETING_SHARE_NOTIFICATIONS_ENABLED=true

# =============================================================================
# Zoom OAuth (scaffold) â€” FILL client id/secret, set ZOOM_OAUTH_ENABLED=true
# Redirect: http://localhost:8083/auth/zoom/callback
# =============================================================================
ZOOM_OAUTH_ENABLED=false
ZOOM_OAUTH_CLIENT_ID=REPLACE_WITH_ZOOM_OAUTH_CLIENT_ID
ZOOM_OAUTH_CLIENT_SECRET=REPLACE_WITH_ZOOM_OAUTH_CLIENT_SECRET
ZOOM_OAUTH_REDIRECT_URI=http://localhost:8083/auth/zoom/callback
ZOOM_OAUTH_FRONTEND_BASE_URL=http://localhost:8080
ZOOM_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
ZOOM_TOKEN_ENCRYPTION_KID=v1
ZOOM_OAUTH_STATE_TTL=10m
ZOOM_OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# =============================================================================
# Microsoft Teams OAuth â€” FILL client id/secret, set TEAMS_OAUTH_ENABLED=true
# Redirect: http://localhost:8083/auth/teams/callback
# =============================================================================
TEAMS_OAUTH_ENABLED=false
TEAMS_OAUTH_CLIENT_ID=REPLACE_WITH_TEAMS_OAUTH_CLIENT_ID
TEAMS_OAUTH_CLIENT_SECRET=REPLACE_WITH_TEAMS_OAUTH_CLIENT_SECRET
TEAMS_OAUTH_REDIRECT_URI=http://localhost:8083/auth/teams/callback
TEAMS_OAUTH_FRONTEND_BASE_URL=http://localhost:8080
TEAMS_OAUTH_TENANT_ID=common
TEAMS_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
TEAMS_TOKEN_ENCRYPTION_KID=v1
TEAMS_OAUTH_STATE_TTL=10m
TEAMS_OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# =============================================================================
# SMTP (optional) â€” fallback when Gmail OAuth unavailable; leave SMTP_HOST empty to skip SMTP
# Rollback Gmail: set GMAIL_SEND_ENABLED=false for SMTP-only (or skipped if SMTP_HOST empty)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.com
NOTIFICATION_FRONTEND_BASE_URL=https://app.audiomind.pro.vn
NOTIFICATION_BRAND_NAME=AudioMind
NOTIFICATION_BRAND_ACCENT_COLOR=#5b4bff
MEETING_SHARE_NOTIFICATIONS_ENABLED=true
# Gmail API for meeting-share emails (from inviter inbox). Set false to use SMTP-only fallback.
# Deploy order when rolling back: set GMAIL_SEND_ENABLED=false and redeploy user-api first.
GMAIL_SEND_ENABLED=true

QUOTA_FAIL_OPEN=false
GOOGLE_USER_SERVICE_URL=http://user-api:8083
AUDIOMIND_USER_API_BASE_URL=http://user-api:8083
AUDIOMIND_MEETING_API_BASE_URL=http://meeting-api:8081
AUDIOMIND_PROCESSING_API_BASE_URL=http://processing-api:8082
GOOGLE_CALENDAR_API_BASE_URL=https://www.googleapis.com/calendar/v3

# =============================================================================
# Frontend build-time (rebuild web after changes)
# =============================================================================
VITE_MEETING_API_BASE_URL=http://localhost:8081
VITE_PROCESSING_API_BASE_URL=http://localhost:8082
VITE_USER_API_BASE_URL=http://localhost:8083
VITE_API_BASE=http://localhost:8082
VITE_REALTIME_WS_ENABLED=true
VITE_REALTIME_WS_BASE_URL=ws://localhost:8082/ws/meetings
VITE_API_CPU_BASE=http://localhost:8000
VITE_API_GPU_BASE=http://localhost:8000
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_AUDIO_DEBUG=false
VITE_GOOGLE_LOGIN_ENABLED=true
VITE_PAYOS_ENABLED=true
VITE_REALTIME_ENABLED=true

# =============================================================================
# STT / AI providers â€” FILL
# =============================================================================
STT_PROVIDER=deepgram
ANALYSIS_PROVIDER=gemini
AI_PROVIDER=gemini
DEEPGRAM_API_KEY=REPLACE_WITH_DEEPGRAM_API_KEY
DEEPGRAM_MODEL=nova-3
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_UTTERANCES=true
DEEPGRAM_PARAGRAPHS=true
DEEPGRAM_SIMPLIFY_STREAMING_URL=false
DEEPGRAM_DEBUG_RAW_MESSAGES=false
DEEPGRAM_REALTIME_MODEL=nova-3
DEEPGRAM_BATCH_MODEL=nova-3
DEEPGRAM_LANGUAGE=vi
DEEPGRAM_ENDPOINTING=
DEEPGRAM_REALTIME_ENDPOINTING_VI=
DEEPGRAM_REALTIME_ENDPOINTING_MULTI=
DEEPGRAM_REALTIME_ENDPOINTING_DEFAULT=
DEEPGRAM_REALTIME_ENDPOINTING_EN=

GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
EMBEDDING_SEARCH_ENABLED=true
GEMINI_API_KEYS=
GEMINI_API_KEY_BACKUP=
GEMINI_MULTI_KEY_ENABLED=false
GEMINI_MAX_ATTEMPTS=3
GEMINI_KEY_COOLDOWN_SECONDS=90
GEMINI_KEY_HARD_COOLDOWN_SECONDS=900
GEMINI_BACKOFF_BASE_MS=500
GEMINI_BACKOFF_MAX_MS=10000
GEMINI_BACKOFF_JITTER=true
GEMINI_FAIL_FAST_SECONDS=30
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_SUMMARY_MODEL=gemini-2.5-flash
# Fallback when preferred model is blocked for new Auth keys (AQ....)
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash,gemini-2.5-flash-lite
GEMINI_ANALYSIS_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_SECONDS=300
GEMINI_ANALYSIS_RETRY_MAX_ATTEMPTS=3
GEMINI_RATE_LIMIT_RETRY_BASE_SECONDS=30
GEMINI_RATE_LIMIT_RETRY_MAX_SECONDS=90
GEMINI_RETRY_QUOTA_EXCEEDED=false
GEMINI_MAX_TOKENS_RETRY_ENABLED=true
GEMINI_MAX_SINGLE_REQUEST_CHARS=50000
GEMINI_REQUEST_DELAY_SECONDS=15
# Gemini only (ANALYSIS_PROVIDER=gemini). Local VN: báº­t Clash/V2Ray + Allow LAN.
# Clash: 7890 | V2RayN: 10809. VPS: Ä‘á»ƒ trá»‘ng.
GEMINI_HTTP_PROXY=http://host.docker.internal:7890
INTERNAL_API_BASE_URL=http://ai-api:8000

LOCAL_WHISPER_ENABLED=false
ALLOW_LEGACY_LOCAL_STT=false
OLLAMA_ENABLED=false
ALLOW_LEGACY_LOCAL_AI=false
OLLAMA_BASE_URL=http://ollama-service:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
HUGGINGFACE_TOKEN=

ENABLE_SPEAKER_DIARIZATION=true
DEEPGRAM_DIARIZE=true
SPEAKER_STABILIZATION_ENABLED=true
SPEAKER_STABILIZATION_VERSION=speaker-stabilization-v1
SPEAKER_MIN_SEGMENT_SECONDS=1.2
SPEAKER_MAX_GAP_SECONDS=1.0
SPEAKER_ISLAND_MAX_SECONDS=2.0
SPEAKER_MAX_MERGED_TURN_SECONDS=20.0
SPEAKER_MAX_REASONABLE_COUNT=8
SPEAKER_STABILIZATION_DRY_RUN=false
SPEAKER_STABILIZATION_LOG_STATS=true
STT_FINAL_RECV_DRAIN_TIMEOUT_SECONDS=2.0
REALTIME_ASYNC_AUDIO_QUEUE_ENABLED=true

# =============================================================================
# Epic 2 + Epic 3 (Gate-A local) â€” enabled for full QA; use scripts/infra/up-gate-a-local.ps1
# =============================================================================
UPLOAD_VALIDATION_STRICT=true
MIME_SNIFF_ENABLED=true
REALTIME_VALIDATION_ENABLED=true
# Dual parallel STT for Tab+Microphone (all three must be true)
REALTIME_DUAL_STREAM_TAB_MIC_ENABLED=false
VITE_REALTIME_DUAL_STREAM_TAB_MIC=false
UPLOAD_SECURITY_SCAN_ENABLED=false
UPLOAD_SCAN_FAIL_OPEN=true
ERROR_UX_ENABLED=true
EPIC3_TRANSCRIPT_QUALITY_ENABLED=true
EPIC3_DOMAIN_LEXICON_ENABLED=true
EPIC3_EVIDENCE_QA_ENABLED=true
EPIC3_SEARCH_VERIFY_ENABLED=true
EPIC3_EXPORT_VERIFY_ENABLED=true
# Note: these flags must reach ai-api and celery-worker (see infra/docker-compose.dev.yml).

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
JOB_STATE_REDIS_URL=redis://redis:6379/2
STT_ENABLE_DISTRIBUTED_OWNERSHIP=true
STT_OWNERSHIP_ENABLED=true
STT_OWNERSHIP_REDIS_URL=redis://redis:6379/2
STT_REPLICA_ID=
STT_OWNERSHIP_LEASE_TTL_SECONDS=30
STT_OWNERSHIP_COOLDOWN_TTL_SECONDS=300
CELERY_CONCURRENCY=4
# Phase 2 study artifact / subject synthesis queue (worker must include this in -Q)
CELERY_STUDY_GENERATION_QUEUE=study_generation
CELERY_PREFETCH_MULTIPLIER=1
CELERY_PREFETCH_MULTIPLIER=1
