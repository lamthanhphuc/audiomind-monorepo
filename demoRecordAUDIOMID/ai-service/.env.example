# Database
POSTGRES_USER=audiomind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=audiomind
DATABASE_URL=postgresql://audiomind:change-me@db:5432/audiomind

# Security
JWT_SECRET=replace-with-long-random-secret
JWT_ACCESS_EXPIRATION_SECONDS=86400

# STT Provider Selection (batch & realtime)
# Options: deepgram, local_whisper
# - deepgram: Uses Deepgram API for both realtime (WebSocket) and batch (prerecorded) transcription
# - local_whisper: Legacy/offline local Whisper model (requires INSTALL_OFFLINE_STT=true)
STT_PROVIDER=deepgram

# Deepgram Configuration (for batch & realtime)
DEEPGRAM_API_KEY=your_deepgram_key_here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_REALTIME_MODEL=nova-3
DEEPGRAM_BATCH_MODEL=nova-3
DEEPGRAM_LANGUAGE=vi
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_UTTERANCES=true
DEEPGRAM_PARAGRAPHS=true

# Legacy local STT (Whisper)
# - Default cloud runtime fails clearly if Deepgram is unavailable.
# - To use local Whisper, build Docker with INSTALL_OFFLINE_STT=true and enable both flags.
LOCAL_WHISPER_ENABLED=false
ALLOW_LEGACY_LOCAL_STT=false

# Runtime component (api | worker | beat). Defaults to api when unset.
# Celery worker/beat deployments must set APP_COMPONENT explicitly.
APP_COMPONENT=api
APP_ENV=development

# API Keys — ANALYSIS_PROVIDER is source of truth (gemini | ollama | fake in non-prod).
# If both AI_PROVIDER and ANALYSIS_PROVIDER are set, they must match.
ANALYSIS_PROVIDER=gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY
GEMINI_API_KEYS=
GEMINI_MULTI_KEY_ENABLED=false
# Share key cooldown across ai-api replicas (requires JOB_STATE_REDIS_URL / Redis).
GEMINI_SHARED_COOLDOWN_ENABLED=false
GEMINI_MAX_ATTEMPTS=3
GEMINI_KEY_COOLDOWN_SECONDS=90
GEMINI_KEY_HARD_COOLDOWN_SECONDS=900
GEMINI_BACKOFF_BASE_MS=500
GEMINI_BACKOFF_MAX_MS=10000
GEMINI_BACKOFF_JITTER=true
GEMINI_FAIL_FAST_SECONDS=30
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_SUMMARY_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=300
GEMINI_ANALYSIS_RETRY_MAX_ATTEMPTS=3
GEMINI_RATE_LIMIT_RETRY_BASE_SECONDS=30
GEMINI_RATE_LIMIT_RETRY_MAX_SECONDS=90
GEMINI_RETRY_QUOTA_EXCEEDED=false
GEMINI_MAX_TOKENS_RETRY_ENABLED=true
GEMINI_MAX_SINGLE_REQUEST_CHARS=50000
GEMINI_REQUEST_DELAY_SECONDS=15
OLLAMA_ENABLED=false
ALLOW_LEGACY_LOCAL_AI=false

# Deepgram Diagnostic (keep false for normal dev/prod)
# - DEEPGRAM_SIMPLIFY_STREAMING_URL: Diagnostic only. Keep false unless isolating Deepgram URL behavior.
# - DEEPGRAM_DEBUG_RAW_MESSAGES: Diagnostic only. Logs capped raw Deepgram text frames; keep false normally.
DEEPGRAM_SIMPLIFY_STREAMING_URL=false
DEEPGRAM_DEBUG_RAW_MESSAGES=false

# STT Scale-out Ownership (multi-replica ai-service deployments)
# - STT_ENABLE_DISTRIBUTED_OWNERSHIP: Keep enabled for scale-out
# - STT_OWNERSHIP_ENABLED: Keep enabled for scale-out
# - STT_REPLICA_ID: Optional stable replica identity. Leave blank for process-local UUID.
STT_ENABLE_DISTRIBUTED_OWNERSHIP=true
STT_OWNERSHIP_ENABLED=true
STT_OWNERSHIP_REDIS_URL=redis://redis:6379/2
STT_REPLICA_ID=
STT_OWNERSHIP_LEASE_TTL_SECONDS=30
STT_OWNERSHIP_COOLDOWN_TTL_SECONDS=300

HUGGINGFACE_TOKEN=your_token_here

# Server
HOST=0.0.0.0
PORT=8000

# Storage
AUDIO_STORAGE_PATH=./storage/audio
TEMP_STORAGE_PATH=./storage/temp

# Optional audio enhancement (requires FFmpeg when enabled)
# Providers: none, ffmpeg. Enhancement always uses the STT filter profile.
# AUDIO_KEEP_ENHANCED_FILE=true is opt-in and needs a separate retention policy.
AUDIO_ENHANCEMENT_ENABLED=false
AUDIO_ENHANCEMENT_PROVIDER=ffmpeg
AUDIO_ENHANCEMENT_TIMEOUT_SECONDS=120
AUDIO_KEEP_ENHANCED_FILE=false

# Exact allowlist for final-audio-fallback paths when set.
# Empty = defaults (/app/uploads, /app/storage/uploads, ./storage/uploads + audio/temp).
FINAL_AUDIO_ALLOWED_ROOTS=

# Required for POST /api/v1/stt/final-audio-fallback (processing-service → ai-service).
# Must match processing-service app.internal.service-token / INTERNAL_SERVICE_TOKEN.
# Leave empty and the endpoint rejects all callers (503 misconfigured) — never public.
INTERNAL_SERVICE_TOKEN=

# Meeting-service base URL for Phase 2 subject membership guards (worker).
# Used by fetch_subject_meeting_ids before Gemini. Leave empty in unit tests
# (falls back to stored source meeting ids).
MEETING_SERVICE_BASE_URL=
MEETING_SERVICE_TIMEOUT_SECONDS=10

# Legacy/offline model settings (ignored by cloud-first Deepgram/Gemini path)
WHISPER_MODEL=base
DEVICE=auto  # auto prefers cuda when available, otherwise cpu
ENABLE_SPEAKER_DIARIZATION=true
DEEPGRAM_DIARIZE=true
LAZY_LOAD_MODELS=true

# Processing
MAX_CHUNK_DURATION=30
VAD_THRESHOLD=0.5

AI_PROVIDER=gemini

# Epic 3 feature flags (must match processing-api / infra/.env)
EPIC3_TRANSCRIPT_QUALITY_ENABLED=true
EPIC3_DOMAIN_LEXICON_ENABLED=true
EPIC3_EVIDENCE_QA_ENABLED=true
EPIC3_SEARCH_VERIFY_ENABLED=true
EPIC3_EXPORT_VERIFY_ENABLED=true

# Legacy/local AI settings (ignored unless ANALYSIS_PROVIDER/AI_PROVIDER uses ollama/local
# and ALLOW_LEGACY_LOCAL_AI=true)
OLLAMA_BASE_URL=http://ollama-service:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=300

# Epic 2 upload/realtime safety (default off)
UPLOAD_VALIDATION_STRICT=false
MIME_SNIFF_ENABLED=false
REALTIME_VALIDATION_ENABLED=false
