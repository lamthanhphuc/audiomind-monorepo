# AudioMind single-domain VPS environment template.
# Copy to .env.production at the repo root and replace every placeholder.
# Do not commit .env.production or real provider secrets.
#
# Docker Compose usage:
#   docker compose --env-file .env.production -f infra/docker-compose.vps.yml up -d

# --- Public single-domain routing (host Nginx terminates TLS) ---
PUBLIC_DOMAIN=your-domain.com
PUBLIC_ORIGIN=https://your-domain.com
PUBLIC_FRONTEND_ORIGIN=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# --- PostgreSQL ---
POSTGRES_DB=audiomind
POSTGRES_USER=audiomind
POSTGRES_PASSWORD=CHANGE_ME_STRONG

# --- Auth / internal service trust ---
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG
JWT_ACCESS_EXPIRATION_SECONDS=86400
INTERNAL_SERVICE_TOKEN=CHANGE_ME_STRONG_TOKEN
# Keep in sync with INTERNAL_SERVICE_TOKEN (compose env-file does not nest-expand)
GOOGLE_INTERNAL_SERVICE_TOKEN=CHANGE_ME_STRONG_TOKEN

# Required by user-api OAuth token encryption (base64-encoded 32-byte key).
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
GOOGLE_TOKEN_ENCRYPTION_KID=v1

APP_ENV=production

# --- Loopback binds for host Nginx (127.0.0.1 only) ---
WEB_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=8080
WEB_HOST_PORT=8080
USER_API_BIND_ADDRESS=127.0.0.1
USER_API_HOST_PORT=8083
MEETING_API_BIND_ADDRESS=127.0.0.1
MEETING_API_HOST_PORT=8081
PROCESSING_API_BIND_ADDRESS=127.0.0.1
PROCESSING_API_HOST_PORT=8082
AI_API_HOST_PORT=8000

# --- Frontend build (same-origin via Nginx path routing) ---
# __SAME_ORIGIN__ is resolved to an empty base URL at build/runtime in FE config.ts.
VITE_USER_API_BASE_URL=__SAME_ORIGIN__
VITE_MEETING_API_BASE_URL=__SAME_ORIGIN__
VITE_PROCESSING_API_BASE_URL=__SAME_ORIGIN__
VITE_API_BASE=__SAME_ORIGIN__
VITE_API_CPU_BASE=__SAME_ORIGIN__
VITE_API_GPU_BASE=__SAME_ORIGIN__
VITE_AI_SERVICE_URL=
VITE_PUBLIC_FRONTEND_ORIGIN=https://your-domain.com
VITE_REALTIME_WS_ENABLED=true
VITE_REALTIME_WS_BASE_URL=wss://your-domain.com/ws/meetings
VITE_AUDIO_DEBUG=false
VITE_GOOGLE_LOGIN_ENABLED=false
VITE_PAYOS_ENABLED=false
VITE_REALTIME_ENABLED=true

# --- MVP provider defaults ---
STT_PROVIDER=deepgram
ANALYSIS_PROVIDER=gemini
AI_PROVIDER=gemini

# --- Deepgram ---
DEEPGRAM_API_KEY=CHANGE_ME
DEEPGRAM_MODEL=nova-3
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_UTTERANCES=true
DEEPGRAM_PARAGRAPHS=true
DEEPGRAM_SIMPLIFY_STREAMING_URL=false
DEEPGRAM_DEBUG_RAW_MESSAGES=false
DEEPGRAM_REALTIME_MODEL=nova-3
DEEPGRAM_BATCH_MODEL=nova-3
DEEPGRAM_LANGUAGE=vi
DEEPGRAM_ENDPOINTING=
DEEPGRAM_REALTIME_ENDPOINTING_DEFAULT=
DEEPGRAM_REALTIME_ENDPOINTING_VI=
DEEPGRAM_REALTIME_ENDPOINTING_EN=
DEEPGRAM_REALTIME_ENDPOINTING_MULTI=

# --- Gemini ---
GEMINI_API_KEY=CHANGE_ME
GEMINI_API_KEYS=
GEMINI_MULTI_KEY_ENABLED=false
GEMINI_MAX_ATTEMPTS=3
GEMINI_KEY_COOLDOWN_SECONDS=90
GEMINI_KEY_HARD_COOLDOWN_SECONDS=900
GEMINI_BACKOFF_BASE_MS=500
GEMINI_BACKOFF_MAX_MS=10000
GEMINI_BACKOFF_JITTER=true
GEMINI_FAIL_FAST_SECONDS=30
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_SUMMARY_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=300
GEMINI_ANALYSIS_RETRY_MAX_ATTEMPTS=3
GEMINI_RATE_LIMIT_RETRY_BASE_SECONDS=30
GEMINI_RATE_LIMIT_RETRY_MAX_SECONDS=90
GEMINI_RETRY_QUOTA_EXCEEDED=false
GEMINI_MAX_TOKENS_RETRY_ENABLED=true
GEMINI_MAX_SINGLE_REQUEST_CHARS=50000
GEMINI_REQUEST_DELAY_SECONDS=15
# VPS: leave empty. Local VN behind geo-block: http://host.docker.internal:7890
GEMINI_HTTP_PROXY=
INTERNAL_API_BASE_URL=http://ai-api:8000

# --- Optional legacy providers (production path is Deepgram + Gemini only) ---
LOCAL_WHISPER_ENABLED=false
ALLOW_LEGACY_LOCAL_STT=false
OLLAMA_ENABLED=false
ALLOW_LEGACY_LOCAL_AI=false
OLLAMA_BASE_URL=http://ollama-service:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
HUGGINGFACE_TOKEN=

# --- Speaker stabilization / Deepgram diarization ---
ENABLE_SPEAKER_DIARIZATION=false
DEEPGRAM_DIARIZE=false
SPEAKER_STABILIZATION_ENABLED=true
SPEAKER_STABILIZATION_VERSION=speaker-stabilization-v1
SPEAKER_MIN_SEGMENT_SECONDS=1.2
SPEAKER_MAX_GAP_SECONDS=1.0
SPEAKER_ISLAND_MAX_SECONDS=2.0
SPEAKER_MAX_MERGED_TURN_SECONDS=20.0
SPEAKER_MAX_REASONABLE_COUNT=8
SPEAKER_STABILIZATION_DRY_RUN=false
SPEAKER_STABILIZATION_LOG_STATS=true

# --- Redis-backed AI service state ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
JOB_STATE_REDIS_URL=redis://redis:6379/2
STT_ENABLE_DISTRIBUTED_OWNERSHIP=true
STT_OWNERSHIP_ENABLED=true
STT_OWNERSHIP_REDIS_URL=redis://redis:6379/2
STT_REPLICA_ID=
STT_OWNERSHIP_LEASE_TTL_SECONDS=30
STT_OWNERSHIP_COOLDOWN_TTL_SECONDS=300
CELERY_CONCURRENCY=2
CELERY_PREFETCH_MULTIPLIER=1

# --- Share-invite emails ---
NOTIFICATION_FRONTEND_BASE_URL=https://your-domain.com
NOTIFICATION_BRAND_NAME=AudioMind
NOTIFICATION_BRAND_ACCENT_COLOR=#5b4bff
NOTIFICATION_FROM_EMAIL=noreply@your-domain.com
MEETING_SHARE_NOTIFICATIONS_ENABLED=true
GMAIL_SEND_ENABLED=false

# --- OAuth / billing (optional on VPS) ---
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/auth/google/callback
GOOGLE_OAUTH_LINK_REDIRECT_URI=https://your-domain.com/auth/google/link/callback
GOOGLE_OAUTH_FRONTEND_BASE_URL=https://your-domain.com
GOOGLE_OAUTH_ALLOWED_REDIRECT_ORIGINS=https://your-domain.com
PAYOS_ENABLED=false
